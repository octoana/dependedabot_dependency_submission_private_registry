<?xml version="1.0" encoding="utf-8"?> 
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/octoana/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Octoana.DependencySubmissionDemo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
